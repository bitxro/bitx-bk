#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

VERSION="0.14.6"
CONFIG="${BITX_BK_CONFIG:-/etc/bitx-bk/bitx-bk.conf}"
COLOR_MODE="${COLOR:-auto}"

setup_colors(){
 RED=""; GREEN=""; YELLOW=""; CYAN=""; BOLD=""; RESET=""
 local use=no
 case "${COLOR_MODE:-auto}" in
  always) use=yes;;
  never) use=no;;
  auto) [[ -t 1 && -z "${NO_COLOR:-}" ]] && use=yes;;
  *) use=no;;
 esac
 if [[ "$use" == yes ]]; then
  RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; CYAN=$'\033[36m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
 fi
}
setup_colors

say(){ printf '%s\n' "$*"; }
info(){ printf '  %b[INFO]%b %s\n' "$CYAN" "$RESET" "$*"; }
ok(){ printf '  %b[OK]%b %s\n' "$GREEN" "$RESET" "$*"; }
warn(){ printf '  %b[WARN]%b %s\n' "$YELLOW" "$RESET" "$*" >&2; }
error(){ printf '  %b[ERROR]%b %s\n' "$RED" "$RESET" "$*" >&2; }
die(){ error "$*"; exit 1; }
heading(){ printf '%b%s%b\n' "$BOLD$CYAN" "$*" "$RESET"; }
pause(){ read -r -p "Press Enter to continue..." _ || true; }

load_config(){
 [[ -r "$CONFIG" ]] || die "Cannot read $CONFIG"
 source "$CONFIG"
 COLOR_MODE="${COLOR:-$COLOR_MODE}"
 setup_colors
}
need_root(){ [[ $EUID -eq 0 ]] || die "Run as root."; }

doctor(){
 need_root; load_config
 heading "BITX-BK System Check v$VERSION"; say "============================"
 for c in bash tar sha256sum find awk sed grep; do command -v "$c" >/dev/null && ok "$c" || warn "$c missing"; done
 command -v restic >/dev/null && ok "$(restic version)" || warn "restic missing"
 command -v systemctl >/dev/null && ok "systemd detected" || warn "systemd not detected"
 command -v docker >/dev/null && ok "Docker detected" || info "Docker not detected"
 command -v wg >/dev/null && ok "WireGuard tools detected" || info "WireGuard tools not detected"
 command -v virtualmin >/dev/null && ok "Virtualmin detected" || info "Virtualmin not detected"
 command -v webmin >/dev/null && ok "Webmin CLI detected" || [[ -d /etc/webmin ]] && ok "Webmin detected" || true
}

docker_audit(){
 need_root
 heading "Docker Recovery Audit"; say "====================="
 command -v docker >/dev/null || { warn "Docker not installed"; return; }
 docker info >/dev/null 2>&1 || { error "Docker daemon unavailable"; return 1; }

 local total complete=0 binds=0 named=0 compose=0
 total=$(docker ps -a -q | wc -l)

 while IFS= read -r c; do
  [[ -n "$c" ]] || continue
  local name image project wd missing=0
  name=$(docker inspect -f '{{.Name}}' "$c" | sed 's#^/##')
  image=$(docker inspect -f '{{.Config.Image}}' "$c")
  project=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$c" 2>/dev/null || true)
  wd=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
  [[ -n "$project" && "$project" != "<no value>" ]] && ((compose+=1))

  say
  printf '  %b%s%b\n' "$BOLD" "$name" "$RESET"
  info "image: $image"
  [[ -n "$project" && "$project" != "<no value>" ]] && info "compose project: $project"
  [[ -n "$wd" && "$wd" != "<no value>" ]] && info "compose dir: $wd"

  while IFS='|' read -r typ src dst vol; do
   [[ -n "$typ" ]] || continue
   if [[ "$typ" == bind ]]; then
    ((binds+=1)); info "bind: $src -> $dst"
    [[ -e "$src" ]] || { error "missing bind source: $src"; missing=1; }
   elif [[ "$typ" == volume ]]; then
    ((named+=1)); info "volume: $vol -> $dst"
   fi
  done < <(docker inspect -f '{{range .Mounts}}{{println .Type "|" .Source "|" .Destination "|" .Name}}{{end}}' "$c" | sed 's/ | /|/g')

  local data_manifest data_group path
  local -a PROJECT_DATA_SOURCES=() PROJECT_DATA_RUNNING=()
  data_manifest=$(mktemp) || return 1
  data_group="$wd"
  [[ -n "$wd" && "$wd" != "<no value>" ]] || data_group="container:$c"
  if docker_project_data "$data_group" "$data_manifest"; then
   for path in "${PROJECT_DATA_SOURCES[@]}"; do ok "New backup data source: $path"; done
   info "Current collector coverage verified; this does not validate older snapshots."
  else
   error "Persistent storage cannot be fully captured for $name"; missing=1
  fi
  rm -f "$data_manifest"

  if ((missing==0)); then
   ok "discovery: COMPLETE"
   info "recovery: NOT TESTED"
   ((complete+=1))
  else
   error "discovery: INCOMPLETE"
   error "recovery: NOT VERIFIED"
  fi
 done < <(docker ps -a -q)

 say
 heading "Summary"
 info "containers: $total"
 info "compose-attached containers: $compose"
 info "bind mounts: $binds"
 info "named volume mounts: $named"
 ok "discovery complete: $complete/$total"
 warn "Database consistency requires application/database-aware backup hooks."
}

virtualmin_audit(){
 need_root
 heading "Virtualmin / Webmin Audit"; say "======================="
 if command -v virtualmin >/dev/null || [[ -d /etc/webmin/virtual-server ]]; then
  ok "Virtualmin detected"
  if command -v virtualmin >/dev/null; then
   local n
   n=$(virtualmin list-domains --name-only 2>/dev/null | sed '/^$/d' | wc -l || true)
   info "virtual servers: $n"
  fi
  [[ -d /etc/webmin ]] && ok "Webmin configuration: /etc/webmin"
  [[ -d /etc/postfix ]] && ok "Postfix"
  [[ -d /etc/dovecot ]] && ok "Dovecot"
  [[ -d /etc/bind ]] && ok "BIND"
  [[ -d /etc/apache2 ]] && ok "Apache"
  [[ -d /etc/nginx ]] && ok "Nginx"
  command -v mysql >/dev/null && ok "MySQL/MariaDB client"
  command -v pg_dump >/dev/null && ok "PostgreSQL tools"
  if command -v virtualmin >/dev/null; then
   ok "Native Virtualmin backup: enabled"
   info "mode: all domains + all features + global Virtualmin settings"
   info "format: newformat (separate domain archives)"
   warn "Recovery uses Virtualmin restore-domain but remains NOT TESTED by bitx-bk."
  else
   warn "Virtualmin data detected, but virtualmin CLI is missing; native backup cannot run."
  fi
 else
  info "Virtualmin not detected"
 fi
}

discover(){
 need_root; load_config
 heading "BITX-BK Discovery v$VERSION"; say "========================"

 heading "[CRON]"
 for p in /etc/crontab /etc/cron.d /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly; do
  [[ -e "$p" ]] && ok "$p"
 done

 heading "[SYSTEMD]"
 if command -v systemctl >/dev/null; then
  info "enabled services: $(systemctl list-unit-files --type=service --state=enabled --no-legend 2>/dev/null | wc -l)"
  info "timers: $(systemctl list-timers --all --no-legend 2>/dev/null | wc -l)"
 else
  info "not detected"
 fi

 heading "[DOCKER]"
 if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
  ok "Docker detected"
  info "containers: $(docker ps -a -q | wc -l)"
  info "images: $(docker image ls -q | sort -u | wc -l)"
  info "volumes: $(docker volume ls -q | wc -l)"
  info "networks: $(docker network ls -q | wc -l)"
  docker ps -a --format '    {{.Names}} -> {{.Image}}'
 else
  info "not detected"
 fi

 heading "[VPN]"
 [[ -d /etc/wireguard ]] && ok "WireGuard" || info "WireGuard not detected"
 [[ -d /etc/openvpn ]] && ok "OpenVPN" || info "OpenVPN not detected"

 heading "[WEB HOSTING]"
 if command -v virtualmin >/dev/null || [[ -d /etc/webmin/virtual-server ]]; then ok "Virtualmin/Webmin"; else info "Virtualmin not detected"; fi

 heading "[RUSTDESK]"
 if systemctl list-unit-files 2>/dev/null | grep -Eq 'hbbs|hbbr' || { command -v docker >/dev/null && docker ps -a --format '{{.Image}} {{.Names}}' 2>/dev/null | grep -qiE 'rustdesk|hbbs|hbbr'; }; then
  ok "RustDesk Server"
 else
  info "not detected"
 fi
}

restic_env(){
 load_config
 [[ -n "${RESTIC_REPOSITORY:-}" ]] || return 1
 export RESTIC_REPOSITORY
 if [[ -n "${RESTIC_PASSWORD_FILE:-}" ]]; then export RESTIC_PASSWORD_FILE; fi

}

save_setting(){
 local key="$1" value="$2" tmp
 mkdir -p "$(dirname "$CONFIG")"
 touch "$CONFIG"
 chmod 600 "$CONFIG"
 tmp=$(mktemp)
 awk -v k="$key" '$0 !~ "^" k "=" {print}' "$CONFIG" > "$tmp"
 printf '%s=%q\n' "$key" "$value" >> "$tmp"
 cat "$tmp" > "$CONFIG"
 rm -f "$tmp"
 chmod 600 "$CONFIG"
}

telegram_secret_file="/etc/bitx-bk/secrets/telegram.conf"

telegram_load(){
 [[ -r "$telegram_secret_file" ]] || return 1
 local mode
 mode=$(stat -c '%a' "$telegram_secret_file" 2>/dev/null || true)
 [[ "$mode" == 600 ]] || { warn "Telegram secret file must be chmod 600."; return 1; }
 source "$telegram_secret_file"
 [[ -n "${TELEGRAM_BOT_TOKEN:-}" && -n "${TELEGRAM_CHAT_ID:-}" ]]
}

telegram_send(){
 local text="$1"
 telegram_load || return 0
 command -v curl >/dev/null || { warn "Telegram notification skipped: curl missing"; return 0; }
 local cfg
 cfg=$(mktemp); chmod 600 "$cfg"
 {
  printf 'silent\nshow-error\nfail\n'
  printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TELEGRAM_BOT_TOKEN"
  printf 'data-urlencode = "chat_id=%s"\n' "$TELEGRAM_CHAT_ID"
  printf 'data-urlencode = "text=%s"\n' "$text"
  printf 'output = "/dev/null"\n'
 } > "$cfg"
 if ! curl --config "$cfg"; then warn "Telegram notification failed (backup result unchanged)."; fi
 rm -f "$cfg"
 return 0
}

telegram_setup(){
 need_root
 command -v curl >/dev/null || { warn "curl is required for Telegram notifications."; return 1; }
 local token chat
 heading "Telegram setup"
 read -r -s -p "Bot token: " token; say
 read -r -p "Chat ID: " chat
 [[ -n "$token" && -n "$chat" ]] || { error "Token and Chat ID are required."; return 1; }
 mkdir -p /etc/bitx-bk/secrets; chmod 700 /etc/bitx-bk/secrets
 { printf 'TELEGRAM_BOT_TOKEN=%q\n' "$token"; printf 'TELEGRAM_CHAT_ID=%q\n' "$chat"; } > "$telegram_secret_file"
 chmod 600 "$telegram_secret_file"
 unset TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
 ok "Telegram credentials saved securely."
 telegram_send "bitx-bk | $(hostname)\nTelegram notifications configured successfully."
}

telegram_status(){
 heading "Telegram notifications"
 if telegram_load; then
  ok "configured"
  info "Chat ID configured"
  command -v curl >/dev/null && ok "curl available" || warn "curl missing"
 else info "not configured"; fi
 unset TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID 2>/dev/null || true
}

configure_local_repo(){
 need_root
 mkdir -p "$(dirname "$CONFIG")"; chmod 700 "$(dirname "$CONFIG")"
 [[ -e "$CONFIG" ]] || { touch "$CONFIG"; chmod 600 "$CONFIG"; }
 load_config
 command -v restic >/dev/null || die "restic missing"
 heading "Configure local Restic repository"

 local path password_file
 read -r -p "Repository directory [/backup/bitx-bk]: " path
 path="${path:-/backup/bitx-bk}"
 [[ "$path" == /* ]] || { error "Use an absolute path."; return 1; }

 password_file="/etc/bitx-bk/restic-password"
 mkdir -p "$path" /etc/bitx-bk
 chmod 700 "$path" /etc/bitx-bk

 if [[ ! -s "$password_file" ]]; then
  if command -v openssl >/dev/null; then
   openssl rand -base64 32 > "$password_file"
  else
   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48 > "$password_file"
   printf '\n' >> "$password_file"
  fi
  chmod 600 "$password_file"
  ok "Generated repository password file."
 else
  info "Using existing repository password file."
 fi

 save_setting RESTIC_REPOSITORY "$path"
 save_setting RESTIC_PASSWORD_FILE "$password_file"
 export RESTIC_REPOSITORY="$path" RESTIC_PASSWORD_FILE="$password_file"

 if [[ -f "$path/config" ]]; then
  info "Existing Restic repository detected."
 else
  restic init || { error "Repository initialization failed."; return 1; }
 fi

 restic snapshots >/dev/null && ok "Repository initialized and verified: $path" || error "Repository verification failed."
}


ensure_restic_password(){
 local password_file="/etc/bitx-bk/restic-password"
 mkdir -p /etc/bitx-bk; chmod 700 /etc/bitx-bk
 if [[ ! -s "$password_file" ]]; then
  if command -v openssl >/dev/null; then openssl rand -base64 32 > "$password_file"
  else tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48 > "$password_file"; printf '\n' >> "$password_file"; fi
  chmod 600 "$password_file"
  ok "Generated repository password file." >&2
 fi
 printf '%s\n' "$password_file"
}

configure_sftp_repo(){
 need_root
 mkdir -p "$(dirname "$CONFIG")"; chmod 700 "$(dirname "$CONFIG")"
 [[ -e "$CONFIG" ]] || { touch "$CONFIG"; chmod 600 "$CONFIG"; }
 load_config
 command -v restic >/dev/null || die "restic missing"
 command -v ssh >/dev/null || { error "OpenSSH client is required."; return 1; }
 command -v ssh-keygen >/dev/null || { error "ssh-keygen is required."; return 1; }
 heading "Configure SFTP Restic repository"
 local host port user base path server_name ssh_dir key pub password_file repo sshcmd auth
 read -r -p "SFTP host/IP: " host
 read -r -p "SSH port [22]: " port; port="${port:-22}"
 read -r -p "SSH user: " user
 read -r -p "Remote base path [/$user]: " base
 base="${base:-/$user}"
 server_name=$(hostname | tr -c 'A-Za-z0-9._-' '_' | sed 's/_$//')
 path="${base%/}/$server_name"
 info "Server folder: $path"
 [[ -n "$host" && -n "$user" ]] || { error "Host and user are required."; return 1; }
 [[ "$port" =~ ^[0-9]+$ ]] || { error "Invalid SSH port."; return 1; }
 [[ "$base" == /* ]] || { error "Remote base path must be absolute."; return 1; }
 [[ -n "$server_name" ]] || { error "Could not determine a safe server folder name."; return 1; }

 ssh_dir="/etc/bitx-bk/ssh"; key="$ssh_dir/id_ed25519"; pub="$key.pub"
 mkdir -p "$ssh_dir"; chmod 700 "$ssh_dir"
 if [[ ! -s "$key" ]]; then
  ssh-keygen -q -t ed25519 -N "" -C "bitx-bk@$(hostname)" -f "$key" || return 1
  chmod 600 "$key"; chmod 644 "$pub"
  ok "Generated dedicated SSH key."
 else
  info "Using existing bitx-bk SSH key."
 fi

 say; heading "SFTP authentication"
 say "  1) Install bitx-bk key using your SSH password"
 say "  2) Key is already authorized on the server"
 say "  0) Cancel"; say
 read -r -p "Select: " auth
 case "$auth" in
  1)
   command -v ssh-copy-id >/dev/null || { error "ssh-copy-id is required for automatic key installation."; return 1; }
   info "Your SSH password will be requested by ssh-copy-id and is NOT stored by bitx-bk."
   info "Verify the server fingerprint carefully if SSH asks on first connection."
   ssh-copy-id -i "$pub" -p "$port" "$user@$host" || { error "Could not install the SSH key."; return 1; }
   ;;
  2)
   info "Using the existing authorized key."
   ;;
  0) return;;
  *) error "Invalid selection."; return 1;;
 esac

 sshcmd="-i $key -p $port -o IdentitiesOnly=yes -o BatchMode=yes"
 info "Testing passwordless SSH authentication..."
 if ! ssh -i "$key" -p "$port" -o IdentitiesOnly=yes -o BatchMode=yes "$user@$host" "true"; then
  error "Key authentication failed."
  info "No SFTP repository settings were saved."
  return 1
 fi
 ok "Passwordless SSH connection verified."
 info "Remote repository path will be handled through SFTP by Restic."

 password_file=$(ensure_restic_password)
 repo="sftp:$user@$host:$path"
 export RESTIC_REPOSITORY="$repo" RESTIC_PASSWORD_FILE="$password_file" RESTIC_SFTP_ARGS="$sshcmd"
 if restic -o "sftp.args=$sshcmd" snapshots >/dev/null 2>&1; then
  ok "Existing Restic repository detected."
 else
  info "Initializing encrypted Restic repository over SFTP..."
  restic -o "sftp.args=$sshcmd" init || { error "SFTP repository initialization failed."; return 1; }
 fi
 save_setting RESTIC_REPOSITORY "$repo"
 save_setting RESTIC_PASSWORD_FILE "$password_file"
 save_setting RESTIC_SFTP_ARGS "$sshcmd"
 ok "SFTP repository configured and verified."
 restic -o "sftp.args=$sshcmd" snapshots >/dev/null || { error "Repository verification failed."; return 1; }
}

repository_status(){
 need_root
 if ! restic_env; then warn "Repository not configured."; return; fi
 heading "Restic Repository"
 info "repository: $RESTIC_REPOSITORY"
 [[ -n "${RESTIC_PASSWORD_FILE:-}" ]] && info "password file: $RESTIC_PASSWORD_FILE"
 if repo_cmd snapshots; then ok "repository accessible"; else error "repository check failed"; return 1; fi
}


disconnect_repository(){
 need_root
 [[ -f "$CONFIG" ]] || { info "No repository configuration found."; return; }
 local current="" answer tmp
 current=$(awk -F= '/^RESTIC_REPOSITORY=/{sub(/^[^=]*=/,""); print; exit}' "$CONFIG" 2>/dev/null || true)
 if [[ -z "$current" ]]; then info "No repository is currently configured."; return; fi
 heading "Disconnect backup repository"
 info "Configured repository: $current"
 warn "This removes only the bitx-bk connection settings."
 info "Repository data, snapshots, SSH keys and the Restic password file will NOT be deleted."
 read -r -p "Disconnect this repository? [y/N]: " answer
 [[ "$answer" =~ ^[Yy]$ ]] || { info "Cancelled."; return; }
 tmp=$(mktemp)
 awk '!/^RESTIC_REPOSITORY=/ && !/^RESTIC_PASSWORD_FILE=/ && !/^RESTIC_SFTP_ARGS=/' "$CONFIG" > "$tmp"
 cat "$tmp" > "$CONFIG"; rm -f "$tmp"; chmod 600 "$CONFIG"
 unset RESTIC_REPOSITORY RESTIC_PASSWORD_FILE RESTIC_SFTP_ARGS 2>/dev/null || true
 ok "Repository disconnected from bitx-bk."
 info "No backup data was deleted."
}

repository_menu(){
 while true; do
  say
  heading "Backup repository"
  say "  1) Configure local directory"
  say "  2) Configure SFTP"
  say "  3) Repository status / snapshots"
  say "  4) Repository check"
  say "  5) Disconnect repository"
  say "  0) Back"
  say
  read -r -p "Select: " x
  case "$x" in
   1) configure_local_repo; pause;;
   2) configure_sftp_repo; pause;;
   3) repository_status; pause;;
   4) repo_cmd check; pause;;
   5) disconnect_repository; pause;;
   0) return;;
   *) warn "Invalid selection";;
  esac
 done
}

repo_cmd(){
 need_root
 command -v restic >/dev/null || die "restic missing"
 restic_env || die "Configure a Restic repository first."
 if [[ -n "${RESTIC_SFTP_ARGS:-}" ]]; then
  restic -o "sftp.args=$RESTIC_SFTP_ARGS" "$@"
 else
  restic "$@"
 fi
}

backup_plan(){
 need_root; load_config
 heading "BITX-BK Backup Plan v$VERSION"; say "=========================="

 command -v restic >/dev/null || { error "restic missing"; return 1; }
 if restic_env && repo_cmd snapshots >/dev/null 2>&1; then
  ok "Restic repository: $RESTIC_REPOSITORY"
 else
  error "Restic repository is not ready"; return 1
 fi

 say; heading "[SYSTEM]"
 [[ "${BACKUP_CRON:-yes}" == yes ]] && ok "Cron configuration"
 [[ "${BACKUP_SYSTEMD:-yes}" == yes ]] && ok "Systemd configuration and unit metadata"
 [[ "${BACKUP_SYSTEM_INFO:-yes}" == yes ]] && ok "System inventory"
 [[ -d /etc/bitx-bk ]] && ok "bitx-bk configuration, Telegram secrets and SFTP key (/etc/bitx-bk)"
 [[ -d /etc/secrets ]] && ok "System secrets (/etc/secrets)"

 local plan_stage="/var/lib/bitx-bk/staging/plan"
 rm -rf "$plan_stage"; mkdir -p "$plan_stage/system"; chmod 700 "$plan_stage"
 collect_local_dependencies "$plan_stage"
 say; heading "[CRON / SYSTEMD DEPENDENCIES]"
 if [[ -s "$plan_stage/system/local-dependencies-resolved.txt" ]]; then
  while IFS= read -r p; do ok "$p"; done < "$plan_stage/system/local-dependencies-resolved.txt"
 else
  info "No additional local dependencies detected"
 fi

 say; heading "[VPN]"
 if [[ "${BACKUP_VPN:-yes}" == yes && -d /etc/wireguard ]]; then ok "WireGuard"; else info "WireGuard not selected/detected"; fi

 local -a projects=() final=() deps=()
 say; heading "[DOCKER]"
 if [[ "${BACKUP_DOCKER:-yes}" == yes ]] && command -v docker >/dev/null && docker info >/dev/null 2>&1; then
  info "containers: $(docker ps -a -q | wc -l)"
  while IFS='|' read -r name image wd; do
   [[ -n "$name" ]] || continue
   if [[ -n "$wd" && "$wd" != "<no value>" ]]; then info "$name -> $image [$wd]"; else info "$name -> $image"; fi
   case "${image,,}" in *mariadb*|*mysql*|*postgres*) warn "database workload: $name ($image) -> logical dump";; esac
  done < <(while IFS= read -r id; do
    docker inspect -f '{{.Name}}|{{.Config.Image}}|{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$id" 2>/dev/null | sed 's#^/##'
   done < <(docker ps -a -q))

  mapfile -t projects < <(docker ps -a -q | xargs -r docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' 2>/dev/null | grep -vE '^$|^<no value>$' | sort -u)
  while IFS= read -r container_id; do
   local project_directory
   project_directory=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$container_id") || return 1
   [[ -n "$project_directory" && "$project_directory" != "<no value>" ]] || projects+=("container:$container_id")
  done < <(docker ps -a -q)
 fi

 if [[ -s "$plan_stage/system/local-dependencies-resolved.txt" ]]; then mapfile -t deps < "$plan_stage/system/local-dependencies-resolved.txt"; fi
 final=("${projects[@]}" "${deps[@]}")
 [[ -d /etc/bitx-bk ]] && final+=("/etc/bitx-bk")
 [[ -d /etc/secrets ]] && final+=("/etc/secrets")
 # Remove duplicates and any child path already covered by a parent source.
 mapfile -t final < <(printf '%s\n' "${final[@]}" | grep '^/' | sort -u | awk '
  { a[NR]=$0 }
  END {
   for(i=1;i<=NR;i++){
    covered=0
    for(j=1;j<=NR;j++) if(i!=j && index(a[i],a[j]"/")==1){covered=1;break}
    if(!covered) print a[i]
   }
  }')

 say; heading "[VIRTUALMIN]"
 if command -v virtualmin >/dev/null || [[ -d /etc/webmin/virtual-server ]]; then
  if command -v virtualmin >/dev/null; then
   local vdomains
   vdomains=$(virtualmin list-domains --name-only 2>/dev/null | sed '/^$/d' | wc -l || true)
   ok "Virtualmin detected: $vdomains virtual server(s)"
   ok "Native backup will run: all domains + all features + global Virtualmin settings"
   info "Format: newformat; destination: encrypted Restic staging"
  else
   error "Virtualmin data detected but virtualmin CLI is missing; backup would fail."
  fi
 else
  info "Virtualmin not detected; native Virtualmin backup will be skipped."
 fi

 say; heading "[FINAL BACKUP SOURCES]"
 info "/var/lib/bitx-bk/staging/current (system metadata, manifests and DB dumps)"
 for p in "${final[@]}"; do [[ -e "$p" ]] && ok "$p" || warn "missing: $p"; done
 if ((${#projects[@]})); then
  say; heading "[DOCKER PERSISTENT DATA]"
  local -a PROJECT_DATA_SOURCES=() PROJECT_DATA_RUNNING=()
  for p in "${projects[@]}"; do
   if ! docker_project_data "$p" "$plan_stage/docker-data.json"; then
    rm -rf "$plan_stage"; error "Persistent data discovery failed; backup cannot proceed safely."; return 1
   fi
   local dependency
   for dependency in "${PROJECT_DATA_SOURCES[@]}"; do ok "$dependency"; done
   info "Containers to stop for $p (including shared consumers): ${#PROJECT_DATA_RUNNING[@]}"
  done
 fi
 rm -rf "$plan_stage"

 say
 warn "PLAN ONLY: no snapshot has been created."
 info "Run backup uses logical DB dumps plus a controlled Docker stop/start consistency window."
}

collect_local_dependencies(){
 local stage="$1"
 local list="$stage/system/local-dependencies.txt"
 : > "$list"

 # Absolute paths referenced by cron definitions.
 local f
 for f in /etc/crontab /etc/cron.d/*; do
  [[ -f "$f" ]] || continue
  grep -Eo '/[^[:space:];|&><()"]+' "$f" 2>/dev/null || true
 done >> "$list"
 crontab -l 2>/dev/null | grep -Eo '/[^[:space:];|&><()"]+' >> "$list" || true

 # Executables, scripts, EnvironmentFile and WorkingDirectory referenced by custom systemd units.
 if command -v systemctl >/dev/null; then
  while IFS= read -r unit; do
   [[ -n "$unit" ]] || continue
   systemctl show "$unit" -p ExecStart -p ExecStartPre -p ExecStartPost -p ExecReload -p ExecStop -p EnvironmentFiles -p WorkingDirectory 2>/dev/null |
    grep -Eo '/[^[:space:];{}|&><()"]+' || true
  done < <(find /etc/systemd/system /usr/local/lib/systemd/system -type f \( -name '*.service' -o -name '*.timer' \) -printf '%f\n' 2>/dev/null | sort -u)
 fi >> "$list"

 sed -i 's/[;,]$//' "$list"
 sort -u -o "$list" "$list"

 local -a deps=()
 while IFS= read -r p; do
  [[ "$p" == /* ]] || continue
  # Keep local/admin-managed dependencies; distro executables are reconstructed from package inventory.
  # Never let a parser artifact expand the backup to an entire generic root.
  case "${p%/}" in
   /root|/home|/opt|/srv|/usr/local) continue ;;
  esac
  case "$p" in
   /root/*|/home/*|/opt/*|/srv/*|/usr/local/*)
    [[ -e "$p" ]] && deps+=("$p")
    ;;
  esac
 done < "$list"

 if (("${#deps[@]}" > 0)); then
  printf '%s\n' "${deps[@]}" | sort -u > "$stage/system/local-dependencies-resolved.txt"
  ok "Local cron/systemd dependencies discovered: $(sort -u "$stage/system/local-dependencies-resolved.txt" | wc -l)"
 else
  : > "$stage/system/local-dependencies-resolved.txt"
  info "No additional local cron/systemd dependencies discovered"
 fi
}

docker_project_data(){
 local project="$1" manifest="$2" inventory helper ids
 command -v python3 >/dev/null || { error "python3 required for persistent Docker data backup"; return 1; }
 helper="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/lib/docker_project_data.py"
 [[ -r "$helper" ]] || { error "Missing Docker data collector: $helper"; return 1; }
 ids=$(docker ps -a -q) || return 1
 local -a all_ids=(); mapfile -t all_ids <<< "$ids"
 [[ -n "$ids" ]] || { error "No containers available for project discovery"; return 1; }
 inventory=$(mktemp) || return 1
 if ! docker inspect "${all_ids[@]}" > "$inventory"; then rm -f "$inventory"; return 1; fi
 if ! python3 "$helper" "$project" "$inventory" "$manifest"; then rm -f "$inventory"; return 1; fi
 rm -f "$inventory"
 mapfile -t PROJECT_DATA_SOURCES < <(python3 -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))["sources"]))' "$manifest" | sed '/^$/d')
 mapfile -t PROJECT_DATA_RUNNING < <(python3 -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))["running_consumers"]))' "$manifest" | sed '/^$/d')
}

collect_and_backup(){
 need_root; load_config
 command -v restic >/dev/null || die "restic missing"
 restic_env || die "Configure a Restic repository first."
 repo_cmd snapshots >/dev/null 2>&1 || die "Restic repository is not accessible."

 local stage host stamp
 host=$(hostname)
 stamp=$(date -u +%Y%m%dT%H%M%SZ)
 stage="/var/lib/bitx-bk/staging/current"
 mkdir -p /var/lib/bitx-bk/staging
 chmod 700 /var/lib/bitx-bk /var/lib/bitx-bk/staging 2>/dev/null || true
 rm -rf "$stage"
 mkdir -p "$stage"
 chmod 700 "$stage"

 mkdir -p "$stage/system" "$stage/docker/inspect" "$stage/docker/databases" "$stage/vpn"
 info "Staging: $stage"

 if [[ "${BACKUP_SYSTEM_INFO:-yes}" == yes ]]; then
  uname -a > "$stage/system/uname.txt"
  [[ ! -r /etc/os-release ]] || cp /etc/os-release "$stage/system/os-release"
  { command -v dpkg >/dev/null && dpkg-query -W -f='${binary:Package}\t${Version}\n'; } > "$stage/system/packages.txt" 2>/dev/null || true
  ip -details addr show > "$stage/system/ip-addresses.txt" 2>/dev/null || true
  ip route show table all > "$stage/system/routes.txt" 2>/dev/null || true
  ok "System inventory collected"
 fi

 if [[ "${BACKUP_CRON:-yes}" == yes ]]; then
  mkdir -p "$stage/system/cron"
  for p in /etc/crontab /etc/cron.d /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly; do
   [[ -e "$p" ]] && cp -a "$p" "$stage/system/cron/" 2>/dev/null || true
  done
  crontab -l > "$stage/system/cron/root.crontab" 2>/dev/null || true
  ok "Cron collected"
 fi

 if [[ "${BACKUP_SYSTEMD:-yes}" == yes ]] && command -v systemctl >/dev/null; then
  mkdir -p "$stage/system/systemd"
  systemctl list-unit-files --no-pager > "$stage/system/systemd/unit-files.txt" 2>/dev/null || true
  systemctl list-timers --all --no-pager > "$stage/system/systemd/timers.txt" 2>/dev/null || true
  for p in /etc/systemd/system /usr/local/lib/systemd/system; do [[ -d "$p" ]] && cp -a "$p" "$stage/system/systemd/" 2>/dev/null || true; done
  ok "Systemd metadata collected"
 fi

 if [[ "${BACKUP_VPN:-yes}" == yes && -d /etc/wireguard ]]; then
  cp -a /etc/wireguard "$stage/vpn/"
  ok "WireGuard collected"
 fi

 collect_local_dependencies "$stage"

 # Virtualmin's native backup is the authoritative application-aware copy for hosted domains.
 # It captures domain data/features plus global Virtualmin settings for restore-domain DR.
 if command -v virtualmin >/dev/null || [[ -d /etc/webmin/virtual-server ]]; then
  if ! command -v virtualmin >/dev/null; then
   error "Virtualmin data detected but the virtualmin CLI is missing."
   error "Backup aborted; native Virtualmin backup cannot be created."
   return 1
  fi
  local virtualmin_dir="$stage/virtualmin"
  mkdir -p "$virtualmin_dir"; chmod 700 "$virtualmin_dir"
  info "Creating native Virtualmin backup..."
  info "All domains + all features + global Virtualmin settings"
  if virtualmin backup-domain --dest "$virtualmin_dir/" --all-domains --all-features --newformat --all-virtualmin; then
   find "$virtualmin_dir" -type f -exec chmod 600 {} + 2>/dev/null || true
   local vfiles vbytes
   vfiles=$(find "$virtualmin_dir" -type f 2>/dev/null | wc -l)
   vbytes=$(du -sb "$virtualmin_dir" 2>/dev/null | awk '{print $1}' || printf '0')
   printf 'virtualmin-native-backup=yes\nvirtualmin-files=%s\nvirtualmin-bytes=%s\n' "$vfiles" "$vbytes" > "$stage/system/virtualmin-backup.txt"
   ok "Native Virtualmin backup complete: $vfiles file(s)"
  else
   error "Native Virtualmin backup failed."
   error "Backup aborted; no Restic snapshot will be created for this run."
   return 1
  fi
 fi

 local -a sources=() compose_project_paths=() standalone_groups=()
 [[ -d /etc/bitx-bk ]] && sources+=("/etc/bitx-bk")
 [[ -d /etc/secrets ]] && sources+=("/etc/secrets")
 if [[ -s "$stage/system/local-dependencies-resolved.txt" ]]; then
  while IFS= read -r p; do [[ -e "$p" ]] && sources+=("$p"); done < "$stage/system/local-dependencies-resolved.txt"
 fi
 if [[ "${BACKUP_DOCKER:-yes}" == yes ]] && command -v docker >/dev/null && docker info >/dev/null 2>&1; then
  docker version > "$stage/docker/version.txt" 2>/dev/null || true
  docker network ls > "$stage/docker/networks.txt" 2>/dev/null || true
  docker image ls --digests > "$stage/docker/images.txt" 2>/dev/null || true

  while IFS= read -r id; do
   [[ -n "$id" ]] || continue
   local name image wd
   name=$(docker inspect -f '{{.Name}}' "$id" | sed 's#^/##')
   image=$(docker inspect -f '{{.Config.Image}}' "$id")
   wd=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$id" 2>/dev/null || true)
   docker inspect "$id" > "$stage/docker/inspect/$name.json"
   if [[ -n "$wd" && "$wd" != "<no value>" ]]; then
    [[ -d "$wd" ]] || { error "Compose directory missing: $wd"; return 1; }
    sources+=("$wd"); compose_project_paths+=("$wd")
   else
    standalone_groups+=("container:$id")
    warn "Standalone container $name: attached persistent mounts will be captured; writable container layer is not backed up."
   fi

   case "${image,,}" in
    *mariadb*|*mysql*)
     info "Creating logical database dump: $name"
     if docker exec "$name" sh -c 'command -v mariadb-dump >/dev/null || command -v mysqldump >/dev/null'; then
      if docker exec "$name" sh -c '
       DUMP=$(command -v mariadb-dump || command -v mysqldump)
       if [ -n "$MYSQL_USER" ] && [ -n "$MYSQL_PASSWORD" ] && [ -n "$MYSQL_DATABASE" ]; then
        exec "$DUMP" -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE" --single-transaction --quick
       elif [ -n "$MARIADB_USER" ] && [ -n "$MARIADB_PASSWORD" ] && [ -n "$MARIADB_DATABASE" ]; then
        exec "$DUMP" -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" "$MARIADB_DATABASE" --single-transaction --quick
       elif [ -n "$MYSQL_ROOT_PASSWORD" ]; then
        exec "$DUMP" -uroot -p"$MYSQL_ROOT_PASSWORD" --all-databases --single-transaction --quick --routines --events
       elif [ -n "$MARIADB_ROOT_PASSWORD" ]; then
        exec "$DUMP" -uroot -p"$MARIADB_ROOT_PASSWORD" --all-databases --single-transaction --quick --routines --events
       else
        exit 44
       fi
      ' > "$stage/docker/databases/$name.sql"; then
       chmod 600 "$stage/docker/databases/$name.sql"; ok "Database dump complete: $name"
      else
       rm -f "$stage/docker/databases/$name.sql"
       error "Database dump failed: $name"
       error "Backup aborted; no snapshot created."
       return 1
      fi
     else
      error "No mariadb-dump/mysqldump found in $name; backup aborted."
      return 1
     fi
     ;;
    *postgres*)
     info "Creating logical PostgreSQL dump: $name"
     if docker exec "$name" sh -c 'command -v pg_dumpall >/dev/null'; then
      if docker exec "$name" sh -c 'exec pg_dumpall -U "${POSTGRES_USER:-postgres}"' > "$stage/docker/databases/$name.sql"; then
       chmod 600 "$stage/docker/databases/$name.sql"; ok "Database dump complete: $name"
      else
       rm -f "$stage/docker/databases/$name.sql"; error "PostgreSQL dump failed: $name"; return 1
      fi
     else error "pg_dumpall missing in $name; backup aborted."; return 1; fi
     ;;
   esac
  done < <(docker ps -a -q)

  mapfile -t sources < <(printf '%s\n' "${sources[@]}" | grep '^/' | sort -u)
  ok "Docker manifests collected"
 fi

 cat > "$stage/manifest.txt" <<EOF
bitx-bk-version=$VERSION
host=$host
created-utc=$stamp
repository=$RESTIC_REPOSITORY
virtualmin-native-backup=$([[ -d "$stage/virtualmin" ]] && echo yes || echo no)
EOF
 printf 'source=%s\n' "${sources[@]}" >> "$stage/manifest.txt"

 say
 heading "Ready to create snapshot"
 ok "Collector staging complete"
 info "Docker project sources: ${#sources[@]}"
 info "Repository: $RESTIC_REPOSITORY"
 info "Starting encrypted backup..."

 local run_id="bitx-bk-run:$stamp"
 local backup_rc=0
 local -a docker_projects=() non_docker_sources=()
 local p

 docker_projects=("${compose_project_paths[@]}" "${standalone_groups[@]}")
 for p in "${sources[@]}"; do
  local is_project=no known
  for known in "${compose_project_paths[@]}"; do [[ "$p" != "$known" ]] || is_project=yes; done
  [[ "$is_project" == yes ]] || non_docker_sources+=("$p")
 done
 mapfile -t docker_projects < <(printf '%s\n' "${docker_projects[@]}" | sed '/^$/d' | sort -u)
 mapfile -t non_docker_sources < <(printf '%s\n' "${non_docker_sources[@]}" | grep '^/' | sort -u)

 # Fail before creating snapshots if persistent project storage cannot be captured.
 mkdir -p "$stage/docker/project-data"
 local -a PROJECT_DATA_SOURCES=() PROJECT_DATA_RUNNING=()
 local -A data_manifests=()
 local manifest_index=0
 for p in "${docker_projects[@]}"; do
  [[ -n "$p" ]] || continue
  ((manifest_index+=1))
  data_manifests["$p"]="$stage/docker/project-data/$manifest_index.json"
  docker_project_data "$p" "${data_manifests[$p]}" || return 1
 done

 # Any container stopped by this run is recorded here so EXIT/INT/TERM can recover it.
 local recovery_file="$stage/docker/stopped-by-bitx-bk"
 : > "$recovery_file"
 _bitx_bk_restart_stopped(){
  [[ -s "$recovery_file" ]] || return 0
  mapfile -t _ids < "$recovery_file"
  if (("${#_ids[@]}" > 0)); then
   docker start "${_ids[@]}" >/dev/null 2>&1 || true
   : > "$recovery_file"
  fi
 }
 trap '_bitx_bk_restart_stopped' EXIT INT TERM

 say
 heading "Backup run: $run_id"
 info "Creating system/metadata snapshot (no Docker downtime)..."
 local -a sys_args=("$stage")
 for p in "${non_docker_sources[@]}"; do sys_args+=("$p"); done
 if ! repo_cmd backup --tag bitx-bk --tag "host:$host" --tag "$run_id" --tag "scope:system" "${sys_args[@]}"; then
  error "System/metadata snapshot failed."
  return 1
 fi
 ok "System/metadata snapshot complete"

 local project
 for project in "${docker_projects[@]}"; do
  [[ "$project" == container:* || -d "$project" ]] || { error "Docker project path missing: $project"; return 1; }
  docker_project_data "$project" "${data_manifests[$project]}" || return 1
  local -a project_running=("${PROJECT_DATA_RUNNING[@]}")
  local -a project_sources=("${PROJECT_DATA_SOURCES[@]}" "$stage/system" "${data_manifests[$project]}")

  say
  heading "Docker project: $project"
  for p in "${PROJECT_DATA_SOURCES[@]}"; do ok "Persistent data source: $p"; done
  if (("${#project_running[@]}" > 0)); then
   printf '%s\n' "${project_running[@]}" > "$recovery_file"
   info "Stopping ${#project_running[@]} running container(s), including shared data consumers..."
   if ! docker stop "${project_running[@]}" >/dev/null; then
    error "Could not stop project cleanly: $project"
    _bitx_bk_restart_stopped
    return 1
   fi
   ok "Project stopped"
  fi

  set +e
  repo_cmd backup --tag bitx-bk --tag "host:$host" --tag "$run_id" --tag "scope:docker" --tag "project:$(basename "$project")" "${project_sources[@]}"
  backup_rc=$?
  set -e

  if (("${#project_running[@]}" > 0)); then
   info "Restarting project containers..."
   if docker start "${project_running[@]}" >/dev/null; then
    : > "$recovery_file"
    ok "Project restarted"
   else
    error "One or more containers could not be restarted: $project"
    error "Check immediately with: docker ps -a"
    return 1
   fi
  fi

  if ((backup_rc!=0)); then
   error "Restic backup failed for project: $project"
   return "$backup_rc"
  fi
  ok "Project snapshot complete"
 done

 trap - EXIT INT TERM
 rm -rf "$stage"
 ok "Backup run completed successfully."
 info "Run tag: $run_id"
 repo_cmd snapshots --tag "$run_id" || true
}

backup(){
 need_root; load_config
 if [[ "${1:-}" == "--dry-run" || "${1:-}" == "--plan" ]]; then backup_plan; return; fi
 local started finished elapsed rc host
 started=$(date +%s); host=$(hostname)
 set +e
 collect_and_backup
 rc=$?
 set -e
 finished=$(date +%s); elapsed=$((finished-started))
 if ((rc==0)); then
  telegram_send "🟢 bitx-bk backup OK — $host
Server: $host
Duration: ${elapsed}s
Repository: ${RESTIC_REPOSITORY:-unknown}"
 else
  telegram_send "🔴 bitx-bk backup FAILED — $host
Server: $host
Duration: ${elapsed}s
Repository: ${RESTIC_REPOSITORY:-unknown}
Exit code: $rc"
 fi
 return "$rc"
}


notifications_menu(){
 while true; do
  say
  heading "Notifications"
  say "  1) Telegram setup / update"
  say "  2) Test Telegram notification"
  say "  3) Status"
  say "  0) Back"
  say
  read -r -p "Select: " x
  case "$x" in
   1) telegram_setup; pause;;
   2) telegram_send "bitx-bk | $(hostname)
Telegram test notification."; ok "Test requested"; pause;;
   3) telegram_status; pause;;
   0) return;;
   *) warn "Invalid selection";;
  esac
 done
}

audits_menu(){
 while true; do
  say
  heading "Audits & diagnostics"
  say "  1) System discovery"
  say "  2) Docker recovery audit"
  say "  3) Virtualmin / Webmin audit"
  say "  4) System check / Doctor"
  say "  5) Restic repository check"
  say "  0) Back"
  say
  read -r -p "Select: " x
  case "$x" in
   1) discover; pause;;
   2) docker_audit; pause;;
   3) virtualmin_audit; pause;;
   4) doctor; pause;;
   5) repo_cmd check; pause;;
   0) return;;
   *) warn "Invalid selection";;
  esac
 done
}

settings_menu(){
 while true; do
  say
  heading "Settings"
  say "  1) Backup repository"
  say "  2) Notifications"
  say "  0) Back"
  say
  read -r -p "Select: " x
  case "$x" in
   1) repository_menu;;
   2) notifications_menu;;
   0) return;;
   *) warn "Invalid selection";;
  esac
 done
}

RECOVERY_CONFIG="${BITX_BK_RECOVERY_CONFIG:-/etc/bitx-bk/recovery.conf}"


# Checks never install packages or execute recovered configuration.
recovery_tools(){
 local c missing=0
 heading "Recovery access requirements"
 for c in restic ssh ssh-keygen python3 mktemp mkdir dirname df uname sed find realpath mv cp; do
  if command -v "$c" >/dev/null; then ok "$c available"
  else error "$c missing (required for Recovery)"; missing=1; fi
 done
 if ((missing)); then
  info "Debian/Ubuntu: apt-get update && apt-get install restic openssh-client python3 coreutils"
  info "Other distributions: install equivalent packages using the native package manager."
  info "Install explicitly, then rerun the check. No package installed automatically."
 fi
 return "$missing"
}

recovery_requirements(){
 local resource="$1" target="${2:-}" c metadata file
 heading "Selected resource requirements: $resource"
 info "Destination architecture: $(uname -m)"
 if [[ -r /etc/os-release ]]; then
  # Display as text; never source snapshot content.
  sed -n '/^PRETTY_NAME=/p' /etc/os-release
 fi
 if [[ -n "${RECOVERY_SNAPSHOT:-}" ]]; then
  for file in os-release uname.txt packages.txt; do
   if metadata=$(recovery_repo_cmd dump "$RECOVERY_SNAPSHOT" "/var/lib/bitx-bk/staging/current/system/$file" 2>/dev/null); then
    if [[ -n "$metadata" ]]; then
     info "Source inventory: $file"
     if [[ "$file" == packages.txt ]]; then
      SOURCE_PACKAGES="$metadata" python3 - "$resource" <<'PYPACKAGES'
import os, re, subprocess, sys
resource = sys.argv[1]
if resource.startswith('/opt/docker'):
    pattern = r'^(docker|containerd|runc)'
elif '/virtualmin' in resource:
    pattern = r'^(webmin|virtualmin|apache|httpd|nginx|php|mariadb|mysql|postgresql|postfix|dovecot|bind9)'
else:
    pattern = r'.'
rows = []
for line in os.environ['SOURCE_PACKAGES'].splitlines():
    parts = line.split()
    if len(parts) == 2 and re.match(pattern, parts[0]):
        rows.append(parts)
if not rows:
    print('UNKNOWN: no usable relevant package records in this snapshot')
for package, version in rows:
    try:
        result = subprocess.run(['dpkg-query', '-W', '-f=${Status}\t${Version}', package],
                                text=True, capture_output=True, check=False)
        status, local = result.stdout.rsplit('\t', 1) if '\t' in result.stdout else ('', '')
        local = local if result.returncode == 0 and status == 'install ok installed' else 'MISSING'
    except FileNotFoundError:
        local = 'UNKNOWN (destination is not dpkg-based)'
    state = 'SAME' if version == local else ('MISSING' if local == 'MISSING' else 'REVIEW')
    print(f'[{state}] {package}: source={version}; destination={local}')
PYPACKAGES
     else
      printf '%s\n' "$metadata"
     fi
    else warn "UNKNOWN: source $file inventory empty"; fi
   else warn "UNKNOWN: source $file inventory absent from selected snapshot"; fi
  done
  warn "Source package inventory is evidence, not an installation list. Exact application requirements/version compatibility still need review."
 fi
 case "$resource" in
  /opt/docker|/opt/docker/*)
   if command -v docker >/dev/null; then
    docker --version || true
    docker compose version >/dev/null 2>&1 && ok "Docker Compose plugin available" || warn "MISSING: Docker Compose plugin (needed for Compose deployments)"
    docker info >/dev/null 2>&1 && ok "Docker daemon accessible" || warn "NOT READY: Docker daemon unavailable or access denied"
   else
    warn "MISSING: Docker Engine and Docker Compose plugin for application startup"
   fi
   info "Install Engine and Compose for your distribution using Docker's official installation instructions."
   warn "Check image architecture/availability, external volumes, bind paths, secrets and host ports. Image software runs inside containers; do not install all source host packages."
   if [[ -n "$target" ]]; then
    info "Recovered Compose files (not executed):"
    find "${target%/}$resource" -type f \( -name compose.yml -o -name compose.yaml -o -name docker-compose.yml -o -name docker-compose.yaml \) -print
   fi
   ;;
  /var/lib/bitx-bk/staging/current/virtualmin*)
   command -v virtualmin >/dev/null && ok "Virtualmin CLI available" || warn "MISSING: Virtualmin CLI for native domain restoration"
   [[ -d /etc/webmin ]] && ok "Webmin configuration present" || warn "MISSING: Webmin configuration"
   for c in apache2 httpd nginx php mariadb mysql psql postfix dovecot named; do
    command -v "$c" >/dev/null && ok "$c detected" || info "$c absent; required only if the archived domain uses it"
   done
   warn "UNKNOWN until native archives/features are reviewed: required web stack, PHP versions/extensions, database engine/version, mail and DNS."
   info "Install a compatible Virtualmin stack using its supported installer on a supported OS; do not install competing web/database stacks blindly."
   warn "Native Virtualmin restore-domain is a separate manual step. Recovered archives do not mean functional websites."
   ;;
  *)
   warn "UNKNOWN: resource-specific runtime requirements. Review source inventory and recovered configuration for systemd/cron, VPN and database dependencies."
   ;;
 esac
 info "File recovery does not require application runtimes. Missing runtimes prevent deployment, not copying data."
 if [[ -n "$target" ]]; then
  df -Pk -- "$target"
  warn "Before startup: review versions, permissions, secrets, network configuration and occupied ports. No service started."
 fi
 return 0
}

recovery_repo_cmd(){
 (
  need_root
  command -v restic >/dev/null || die "restic missing"
  [[ -r "$RECOVERY_CONFIG" ]] || die "Configure the Recovery repository first (Recovery -> 6)."
  unset RESTIC_REPOSITORY RESTIC_PASSWORD RESTIC_PASSWORD_FILE RESTIC_PASSWORD_COMMAND RESTIC_SFTP_ARGS
  source "$RECOVERY_CONFIG"
  [[ -n "${RECOVERY_REPOSITORY:-}" && -r "${RECOVERY_PASSWORD_FILE:-}" ]] || die "Incomplete Recovery configuration"
  export RESTIC_REPOSITORY="$RECOVERY_REPOSITORY" RESTIC_PASSWORD_FILE="$RECOVERY_PASSWORD_FILE"
  case "${1:-}" in snapshots|ls|restore|dump|stats) ;; *) die "Command not allowed in Recovery";; esac
  restic --no-lock -o "sftp.args=$RECOVERY_SFTP_ARGS" "$@"
 )
}

recovery_configure(){
 need_root
 recovery_tools || return 1
 local host port user path auth password key sshargs tmp secret
 for c in ssh-keygen ssh restic; do command -v "$c" >/dev/null || { error "$c missing"; return 1; }; done
 heading "Connect to an EXISTING Recovery repository"
 read -r -p "SFTP host/IP: " host || return 1
 read -r -p "SSH port [22]: " port || return 1; port="${port:-22}"
 read -r -p "SSH user: " user || return 1
 read -r -p "Exact absolute repository path (including source server folder): " path || return 1
 [[ "$host" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ && "$user" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { error "Invalid host or user (use a hostname or IPv4 address)"; return 1; }
 [[ "$port" =~ ^[0-9]{1,5}$ ]] && ((10#$port > 0 && 10#$port <= 65535)) || { error "Invalid port"; return 1; }
 [[ "$path" == /* && "$path" != *$'\n'* && "$path" != *$'\r'* ]] || { error "Use an absolute repository path"; return 1; }
 mkdir -p /etc/bitx-bk/recovery/ssh; chmod 700 /etc/bitx-bk/recovery /etc/bitx-bk/recovery/ssh
 key=/etc/bitx-bk/recovery/ssh/id_ed25519
 if [[ ! -e "$key" ]]; then
  ssh-keygen -q -t ed25519 -N "" -C "bitx-bk-recovery@$(hostname)" -f "$key" || return 1
 fi
 chmod 600 "$key"
 ssh-keygen -y -f "$key" > "$key.pub" || return 1
 info "Dedicated Recovery public key:"
 cat "$key.pub"
 say "  1) Authorize key using SSH password (ssh-copy-id)"
 say "  2) Key already authorized / authorize it manually"
 say "  0) Cancel"
 read -r -p "Select: " auth || return 1
 case "$auth" in
  1) command -v ssh-copy-id >/dev/null || { error "ssh-copy-id missing"; return 1; }
     ssh-copy-id -i "$key.pub" -p "$port" "$user@$host" || return 1;;
  2) info "The public key must be authorized before continuing";;
  *) return 1;;
 esac
 info "Check the SSH host fingerprint if prompted. The storage account may be restricted to read-only SFTP."
 read -r -s -p "Original Restic password: " password || return 1; say
 [[ -n "$password" ]] || { error "Password required"; return 1; }
 secret=$(mktemp /etc/bitx-bk/recovery/password.XXXXXX) || return 1
 chmod 600 "$secret"; printf '%s\n' "$password" > "$secret"; unset password
 sshargs="-i $key -p $port -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=ask"
 if ! (unset RESTIC_PASSWORD RESTIC_PASSWORD_COMMAND; export RESTIC_REPOSITORY="sftp:$user@$host:$path" RESTIC_PASSWORD_FILE="$secret"; restic --no-lock -o "sftp.args=$sshargs" snapshots >/dev/null); then
  rm -f "$secret"; error "Connection/decryption failed; previous Recovery settings preserved. No repository initialized."; return 1
 fi
 tmp=$(mktemp "${RECOVERY_CONFIG}.XXXXXX") || { rm -f "$secret"; return 1; }
 { printf 'RECOVERY_REPOSITORY=%q\n' "sftp:$user@$host:$path"; printf 'RECOVERY_PASSWORD_FILE=%q\n' "$secret"; printf 'RECOVERY_SFTP_ARGS=%q\n' "$sshargs"; } > "$tmp"
 chmod 600 "$tmp"; mv "$tmp" "$RECOVERY_CONFIG"
 ok "Existing Recovery repository verified. Backup configuration unchanged."
}

recovery_restore(){
 recovery_tools || return 1
 recovery_select || return 1
 local listing choices selection resource target parent answer rc mode destination stage
 listing=$(mktemp); choices=$(mktemp)
 if ! recovery_repo_cmd ls --json "$RECOVERY_SNAPSHOT" > "$listing"; then rm -f "$listing" "$choices"; return 1; fi
 if ! python3 - "$listing" > "$choices" <<'PYRES'
import json, sys
roots = set()
for line in open(sys.argv[1]):
    n = json.loads(line)
    if n.get('struct_type') == 'snapshot':
        roots.update(n.get('paths', []))
    elif n.get('struct_type') == 'node':
        p = n['path']
        if p.startswith('/opt/docker/') and len(p.split('/')) == 4:
            roots.add(p)
        if p == '/var/lib/bitx-bk/staging/current/virtualmin':
            roots.add(p)
for p in sorted(roots):
    if p.startswith('/') and '\n' not in p and '\r' not in p:
        print(p)
PYRES
 then rm -f "$listing" "$choices"; return 1; fi
 if [[ ! -s "$choices" ]]; then error "No selectable roots in snapshot"; rm -f "$listing" "$choices"; return 1; fi
 local -a resources=(); mapfile -t resources < "$choices"
 local i; for i in "${!resources[@]}"; do printf '  %s) %s\n' "$((i+1))" "${resources[i]}"; done
 read -r -p "Resource number (0 to cancel): " selection || selection=0
 [[ "$selection" =~ ^[1-9][0-9]{0,5}$ ]] && ((selection<=${#resources[@]})) || { rm -f "$listing" "$choices"; return 1; }
 resource="${resources[selection-1]}"; rm -f "$listing" "$choices"
 recovery_requirements "$resource"
 if [[ "$resource" == *'*'* || "$resource" == *'?'* || "$resource" == *'['* || "$resource" == *']'* ]]; then
  error "Resource path contains unsupported pattern characters"; return 1
 fi
 warn "Only data present in this snapshot can be restored. External Docker volumes and local images may be absent in older backups."
 say "  1) Restore to original path: $resource (must not exist)"
 say "  2) Restore to a new directory (preserve original hierarchy)"
 say "  0) Cancel"
 read -r -p "Destination mode [1]: " mode || return 1
 mode="${mode:-1}"
 case "$mode" in
  1)
   [[ "$resource" != / && "$(realpath -m -- "$resource")" == "$resource" ]] || { error "Original path must be canonical and must not traverse symlinks"; return 1; }
   [[ ! -e "$resource" && ! -L "$resource" ]] || { error "Original destination already exists; nothing overwritten. Use a new directory to inspect the backup."; return 1; }
   destination="$resource"
   parent=$(dirname "$resource")
   while [[ ! -e "$parent" && ! -L "$parent" ]]; do parent=$(dirname "$parent"); done
   [[ -d "$parent" ]] || { error "Original path parent is not a directory"; return 1; }
   ;;
  2)
   read -r -p "NEW absolute destination directory: " target || return 1
   [[ "$target" == /* && "$target" != / && "$target" != *$'\n'* && "$target" != *$'\r'* ]] || { error "Invalid destination"; return 1; }
   parent=$(dirname "$target")
   [[ -d "$parent" && ! -e "$target" && ! -L "$target" ]] || { error "Parent must exist and destination must not exist"; return 1; }
   destination="${target%/}$resource"
   ;;
  0) info "Cancelled"; return 1;;
  *) error "Invalid destination mode"; return 1;;
 esac
 df -Pk -- "$parent"
 warn "Allow space for restored data and runtime images/databases; displayed free space is not a guaranteed size estimate."
 info "Snapshot: $RECOVERY_SNAPSHOT"
 info "Resource: $resource"
 info "Destination: $destination"
 read -r -p "Type RESTORE to proceed: " answer || return 1
 [[ "$answer" == RESTORE ]] || { info "Cancelled"; return 1; }
 if [[ "$mode" == 1 ]]; then
  target=$(mktemp -d "$parent/.bitx-bk-restore.XXXXXX") || return 1
 else
  mkdir -m 700 -- "$target" || return 1
 fi
 if recovery_repo_cmd restore "$RECOVERY_SNAPSHOT" --target "$target" --include "$resource" --verify; then
  if [[ "$mode" == 1 ]]; then
   stage="${target%/}$resource"
   # Verify again after restoration; never replace an existing destination.
   if [[ "$(realpath -m -- "$resource")" != "$resource" || -e "$resource" || -L "$resource" ]]; then
    error "Original destination changed or now exists; verified files kept in $target"; return 1
   fi
   [[ -e "$stage" || -L "$stage" ]] || { error "Selected resource missing after restore; files kept in $target"; return 1; }
   mkdir -p -- "$(dirname "$resource")" || { error "Cannot create parent; files kept in $target"; return 1; }
   mv -T -n -- "$stage" "$resource" || { error "Cannot move resource; files kept in $target"; return 1; }
   [[ ! -e "$stage" && ! -L "$stage" ]] || { error "Destination already exists; verified files kept in $target"; return 1; }
   # The temporary hierarchy is empty now; remove empty directories only.
   find "$target" -depth -type d -empty -delete
   target=/
  fi
  ok "Restore verified: $destination"
  recovery_requirements "$resource" "$target"
  info "No service started and no existing application overwritten."
  info "Review Compose, bind mounts, volumes, image availability, ports and architecture before deployment."
  case "$resource" in /opt/docker/*) info "Use Recovery -> 9 to prepare missing external Docker networks in $destination.";; esac
 else
  rc=$?; error "Restore failed (exit $rc); partial files kept in $target for inspection"; return "$rc"
 fi
}

# Recovery reads its own repository; existing destinations are never overwritten.
recovery_snapshots(){
 local json
 command -v python3 >/dev/null || { error "python3 is required for Recovery"; return 1; }
 json=$(recovery_repo_cmd snapshots --json) || { error "Could not read snapshots"; return 1; }
 [[ -n "$json" ]] || json='[]'
 RECOVERY_SNAPSHOTS="$json" python3 - <<'PYJSON'
import json, os
try:
    snapshots = json.loads(os.environ['RECOVERY_SNAPSHOTS'])
    for i, item in enumerate(reversed(snapshots), 1):
        print(f"  {i}) {item['short_id']}  {item.get('time', '?')}  {item.get('hostname', '?')}")
        print("     Tags: " + ", ".join(item.get('tags', [])))
    if not snapshots:
        print("  No bitx-bk snapshots found.")
except (ValueError, KeyError, TypeError) as exc:
    raise SystemExit(f"Invalid snapshot metadata: {exc}")
PYJSON
}

recovery_select(){
 local json choice selected
 command -v python3 >/dev/null || { error "python3 is required for Recovery"; return 1; }
 json=$(recovery_repo_cmd snapshots --json) || return 1
 [[ -n "$json" ]] || json='[]'
 RECOVERY_SNAPSHOTS="$json" python3 - <<'PYJSON' || return 1
import json, os
items = list(reversed(json.loads(os.environ['RECOVERY_SNAPSHOTS'])))
for i, item in enumerate(items, 1):
    print(f"  {i}) {item['short_id']}  {item.get('time', '?')}  {item.get('hostname', '?')}  {', '.join(item.get('tags', []))}")
PYJSON
 read -r -p "Select snapshot number (0 to cancel): " choice || return 1
 [[ "$choice" == 0 ]] && return 1
 [[ "$choice" =~ ^[1-9][0-9]*$ ]] || { warn "Invalid selection"; return 1; }
 selected=$(RECOVERY_SNAPSHOTS="$json" python3 - "$choice" <<'PYJSON'
import json, os, sys
items = list(reversed(json.loads(os.environ['RECOVERY_SNAPSHOTS'])))
i = int(sys.argv[1]) - 1
if 0 <= i < len(items):
    print(items[i]['id'])
PYJSON
 )
 [[ -n "$selected" ]] || { warn "Snapshot number not found"; return 1; }
 RECOVERY_SNAPSHOT="$selected"
}

recovery_inventory(){
 local listing rc
 listing=$(mktemp) || return 1
 if ! recovery_repo_cmd ls --json "$RECOVERY_SNAPSHOT" > "$listing"; then
  rm -f "$listing"; error "Could not inspect snapshot"; return 1
 fi
 python3 - "$RECOVERY_SNAPSHOT" "${1:-details}" "$listing" <<'PYJSON'
import json, os, sys
snapshot, mode, listing = sys.argv[1:]
paths = {}
for line in open(listing):
    record = json.loads(line)
    if record.get('struct_type') == 'node':
        paths[record['path']] = record

def present(prefix):
    return any(path == prefix or path.startswith(prefix + '/') for path in paths)

def show(label, prefix):
    print(f"  [{'OK' if present(prefix) else 'INFO'}] {label}: {prefix}" + ('' if present(prefix) else ' (not in this snapshot)'))

print(f"Snapshot: {snapshot}")
if mode == 'docker':
    projects = sorted({p.split('/')[3] for p in paths if p.startswith('/opt/docker/') and len(p.split('/')) > 3})
    if not projects:
        print('  No Docker projects in this snapshot.')
    for name in projects:
        base = '/opt/docker/' + name
        print(f"  Project: {name}")
        compose = [p for p in (base+'/compose.yaml', base+'/compose.yml', base+'/docker-compose.yml', base+'/docker-compose.yaml') if p in paths]
        print('  [OK] Compose file: ' + compose[0] if compose else '  [WARN] Compose file not found')
        show('Environment file', base+'/.env')
    show('Docker metadata', '/var/lib/bitx-bk/staging/current/docker')
elif mode == 'virtualmin':
    prefix = '/var/lib/bitx-bk/staging/current/virtualmin/'
    files = [n for p,n in paths.items() if p.startswith(prefix) and n.get('type') == 'file']
    print(f"  Native Virtualmin backup files: {len(files)}")
    print(f"  Total bytes: {sum(n.get('size', 0) for n in files)}")
    if not files:
        print('  [WARN] No Virtualmin archives in this snapshot.')
else:
    print('[SYSTEM]')
    for label, path in (('Configuration','/etc/bitx-bk'), ('Secrets','/etc/secrets'), ('Scripts','/usr/local/bin'), ('Staging','/var/lib/bitx-bk/staging/current')):
        show(label, path)
    print('[DOCKER]')
    projects = sorted({p.split('/')[3] for p in paths if p.startswith('/opt/docker/') and len(p.split('/')) > 3})
    for name in projects: show('Project', '/opt/docker/'+name)
    if not projects: print('  No Docker projects in this snapshot.')
    print('[VIRTUALMIN]')
    show('Native archives', '/var/lib/bitx-bk/staging/current/virtualmin')
    if mode == 'plan':
        print('Entries marked [OK] are present and could be selected for a future restore.')
        print('No files changed. Use Recovery option 7 to restore a selected resource to its original path or a new directory.')
PYJSON
 rc=$?
 rm -f "$listing"
 return "$rc"
}

# Isolate each action so failures (including die) return to the interactive
# menu, while retaining errexit inside the action and for CLI commands.
recovery_menu_action(){
 set +e
 (set -e; "$@")
 local rc=$?
 set -e
 if ((rc != 0)); then
  info "Recovery action ended (exit $rc). Returning to Recovery menu."
 fi
 return 0
}

recovery_docker_networks(){
 need_root
 local project="${1:-}" config networks name static answer
 local -a missing=()
 command -v docker >/dev/null && command -v python3 >/dev/null || { error "Docker and python3 are required"; return 1; }
 docker compose version >/dev/null 2>&1 || { error "Docker Compose plugin is required"; return 1; }
 docker info >/dev/null 2>&1 || { error "Docker daemon is unavailable"; return 1; }
 if [[ -z "$project" ]]; then read -r -p "Recovered Compose project directory: " project || return 1; fi
 [[ "$project" == /* && -d "$project" ]] || { error "Use an existing absolute project directory"; return 1; }
 # Do not discover Compose files in ancestor directories or inherited projects.
 local compose
 for compose in compose.yaml compose.yml docker-compose.yml docker-compose.yaml; do
  [[ ! -f "$project/$compose" ]] || break
 done
 [[ -f "$project/$compose" ]] || { error "No Compose file in $project"; return 1; }
 config=$(mktemp) || return 1
 if ! (cd -- "$project" && unset COMPOSE_FILE COMPOSE_PROJECT_NAME && docker compose config --format json) > "$config"; then
  rm -f "$config"; error "Compose configuration invalid; no networks created"; return 1
 fi
 if ! networks=$(python3 - "$config" <<'PYNETWORKS'
import json, re, sys
data = json.load(open(sys.argv[1]))
result = {}
for key, value in data.get('networks', {}).items():
    if not value.get('external'):
        continue
    name = value.get('name', key)
    if not isinstance(name, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*', name):
        raise SystemExit('Invalid external network name')
    static = any(
        isinstance(service.get('networks'), dict)
        and isinstance(service['networks'].get(key), dict)
        and any(service['networks'][key].get(ip) for ip in ('ipv4_address', 'ipv6_address'))
        for service in data.get('services', {}).values()
    )
    result[name] = result.get(name, False) or static
for name, static in sorted(result.items()):
    print(name + '\t' + ('yes' if static else 'no'))
PYNETWORKS
 ); then
  rm -f "$config"; error "Could not read external networks; no networks created"; return 1
 fi
 rm -f "$config"
 [[ -n "$networks" ]] || { info "No external networks required by this Compose project"; return 0; }
 while IFS=$'\t' read -r name static; do
  if docker network inspect "$name" >/dev/null 2>&1; then
   ok "External network already exists: $name"
  elif [[ "$static" == yes ]]; then
   error "$name requires static container addresses; restore its original subnet/IPAM configuration manually. No networks created."; return 1
  else
   missing+=("$name"); info "Missing external network: $name"
  fi
 done <<< "$networks"
 ((${#missing[@]})) || { ok "All external networks already exist"; return 0; }
 warn "Compose external networks do not specify their original driver/subnet. This creates default bridge networks with Docker-assigned subnets; existing networks stay unchanged."
 read -r -p "Create all missing networks as default bridge networks? [y/N]: " answer || return 1
 case "$answer" in y|Y|yes|YES) ;; *) info "Cancelled; no networks created"; return 0;; esac
 for name in "${missing[@]}"; do
  if docker network inspect "$name" >/dev/null 2>&1; then
   ok "External network already exists: $name"
  elif docker network create --driver bridge "$name" >/dev/null; then
   ok "Created external network: $name"
  else
   error "Could not create $name; networks already created were retained"; return 1
  fi
 done
 info "Networks prepared. No containers started. Run docker compose up -d from $project when ready."
}

recovery_docker_restore_all(){
 need_root
 recovery_tools || return 1
 command -v docker >/dev/null || { error "Docker is required to register recovered volumes"; return 1; }
 docker info >/dev/null 2>&1 || { error "Docker daemon unavailable"; return 1; }
 recovery_select || return 1
 local listing manifest metadata helper answer target rc
 helper="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/lib/docker_restore_bundle.py"
 [[ -r "$helper" ]] || { error "Docker bundle recovery helper missing"; return 1; }
 listing=$(mktemp) || return 1
 metadata=$(mktemp) || { rm -f "$listing"; return 1; }
 if ! recovery_repo_cmd ls --json "$RECOVERY_SNAPSHOT" > "$listing"; then rm -f "$listing" "$metadata"; return 1; fi
 if ! manifest=$(python3 - "$listing" <<'PYBUNDLE'
import json, re, sys
paths = set()
for line in open(sys.argv[1]):
    row = json.loads(line)
    candidates = row.get('paths', []) if row.get('struct_type') == 'snapshot' else [row.get('path', '')]
    for path in candidates:
        if re.fullmatch(r'/var/lib/bitx-bk/staging/current/docker/project-data/[0-9]+\.json', path):
            paths.add(path)
if len(paths) != 1:
    raise SystemExit('Select one Docker data snapshot made with v0.14.5 or later; exactly one project manifest is required.')
print(next(iter(paths)))
PYBUNDLE
 ); then rm -f "$listing" "$metadata"; return 1; fi
 if ! recovery_repo_cmd dump "$RECOVERY_SNAPSHOT" "$manifest" > "$metadata"; then rm -f "$listing" "$metadata"; return 1; fi
 if ! python3 "$helper" plan "$metadata" "$listing"; then rm -f "$listing" "$metadata"; return 1; fi
 rm -f "$listing"
 warn "This restores all project paths and named local volume data. Existing different files or nonempty volumes are refused. No containers started."
 read -r -p "Type RESTORE to recover the complete Docker snapshot: " answer || { rm -f "$metadata"; return 1; }
 [[ "$answer" == RESTORE ]] || { rm -f "$metadata"; info "Cancelled"; return 1; }
 mkdir -p /var/lib/bitx-bk/recovery || { rm -f "$metadata"; return 1; }
 chmod 700 /var/lib/bitx-bk/recovery
 target=$(mktemp -d /var/lib/bitx-bk/recovery/docker-restore.XXXXXX) || { rm -f "$metadata"; return 1; }
 mv -- "$metadata" "$target/bundle-manifest.json" || return 1
 info "Verified recovery staging: $target"
 if ! recovery_repo_cmd restore "$RECOVERY_SNAPSHOT" --target "$target" --verify; then
  error "Restore/verification failed; no project data deployed. Partial files retained in $target"; return 1
 fi
 # Deployment runs only after Restic verifies the entire snapshot.
 if python3 "$helper" apply "$target/bundle-manifest.json" "$target"; then
  ok "Complete Docker data recovery finished. No containers started."
  info "Source inventory and manifests retained in $target"
  info "Use Recovery -> 9 to prepare external networks, then review Compose before startup."
 else
  rc=$?; error "Deployment stopped (exit $rc). Verified files retained in $target; any data already copied is retained for inspection."; return "$rc"
 fi
}

recovery_menu(){
 need_root
 recovery_tools || true
 while true; do
  say
  heading "Recovery / Disaster Recovery"
  say "  1) Snapshot browser"
  say "  2) Snapshot details"
  say "  3) Restore plan"
  say "  4) Docker recovery audit"
  say "  5) Virtualmin recovery audit"
  say "  6) Connect existing SFTP repository (read-only)"
  say "  7) Restore selected resource (original path or new directory)"
  say "  8) Check local Recovery requirements"
  say "  9) Prepare external Docker networks for recovered project"
  say "  10) Restore complete Docker snapshot (project + volumes + bind mounts)"
  say "  0) Back"
  say
  read -r -p "Select: " x || return
  case "$x" in
   10) recovery_menu_action recovery_docker_restore_all; pause;;
   9) recovery_menu_action recovery_docker_networks; pause;;
   8) recovery_menu_action recovery_tools; pause;;
   6) recovery_menu_action recovery_configure; pause;;
   7) recovery_menu_action recovery_restore; pause;;
   1) recovery_menu_action recovery_snapshots; pause;;
   2|3|4|5)
    if recovery_select; then
     case "$x" in
      2) recovery_menu_action recovery_inventory details;;
      3) recovery_menu_action recovery_inventory plan;;
      4) recovery_menu_action recovery_inventory docker;;
      5) recovery_menu_action recovery_inventory virtualmin;;
     esac
    fi
    pause;;
   0) return;;
   *) warn "Invalid selection";;
  esac
 done
}

app_update(){
 need_root
 local script project_root
 command -v git >/dev/null || { error "git is required for updates"; return 1; }
 script=$(readlink -f "${BASH_SOURCE[0]}") || { error "Could not locate bitx-bk"; return 1; }
 project_root=$(dirname "$(dirname "$script")")
 [[ -d "$project_root/.git" && -f "$project_root/deploy.sh" ]] || {
  error "Updates require a Git installation with deploy.sh (normally /opt/bitx-bk)."
  return 1
 }
 if ! bash "$project_root/deploy.sh"; then
  error "Update failed. Review the deployment output above."
  return 1
 fi
 if [[ "${1:-}" == restart ]]; then
  info "Reloading the application..."
  exec bash "$script"
 fi
}

menu(){
 need_root
 while true; do
  clear 2>/dev/null || true
  heading "======================================================"
  heading " bitx-bk v$VERSION - Backup & Disaster Recovery"
  info "Host: $(hostname)"
  heading "======================================================"
  say "  1) Run backup"
  say "  2) Backup plan"
  say "  3) Snapshots"
  say "  4) Recovery"
  say "  5) Audits & diagnostics"
  say "  6) Settings"
  say "  7) Update application"
  say "  0) Exit"
  say
  read -r -p "Select: " choice
  case "$choice" in
   1) backup; pause;;
   2) backup --plan; pause;;
   3) repo_cmd snapshots --tag bitx-bk; pause;;
   4) recovery_menu;;
   5) audits_menu;;
   6) settings_menu;;
   7) app_update restart || true; pause;;
   0) return;;
   *) warn "Invalid selection"; sleep 1;;
  esac
 done
}

usage(){
 cat <<EOF
bitx-bk v$VERSION
Usage: bitx-bk [command]
No command opens the interactive menu.
Commands: doctor, discover, docker-audit, virtualmin-audit, repo-config-local, repo-config-sftp, repo-status, telegram-setup, telegram-test, backup --plan, backup, snapshots, check, update
Recovery commands: recovery-config-sftp, recovery-snapshots, recovery-restore, recovery-docker-restore, recovery-doctor
Colors: COLOR=auto|always|never (default auto); NO_COLOR disables colors in auto mode.
EOF
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift || true
case "$cmd" in
 "") menu;;
 doctor) doctor;;
 discover) discover;;
 docker-audit) docker_audit;;
 virtualmin-audit) virtualmin_audit;;
 repo-config-local) configure_local_repo;;
 repo-config-sftp) configure_sftp_repo;;
 telegram-setup) telegram_setup;;
 telegram-test) telegram_send "bitx-bk | $(hostname)\nTelegram test notification.";;
 repo-status) repository_status;;
 backup) backup "${1:-}";;
 snapshots) repo_cmd snapshots --tag bitx-bk;;
 check) repo_cmd check;;
 update) app_update;;
 recovery-doctor) recovery_tools;;
 recovery-config-sftp) recovery_configure;;
 recovery-snapshots) recovery_snapshots;;
 recovery-restore) recovery_restore;;
 recovery-docker-restore) recovery_docker_restore_all;;
 version|--version|-V) echo "$VERSION";;
 help|--help|-h) usage;;
 *) usage; exit 2;;
esac
